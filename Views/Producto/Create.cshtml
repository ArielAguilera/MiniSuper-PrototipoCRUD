@model PrototipoCRUD.Models.Producto
@{
    ViewData["Title"] = "Nuevo producto";
}

<h2>Registrar nuevo producto</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @* Muestra errores generales arriba del formulario *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" placeholder="Ej: 7771234567890" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Leche PIL 1L" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Precio" class="form-label">Precio (Bs.)</label>
                <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Stock" class="form-label"></label>
                <input asp-for="Stock" class="form-control" type="number" min="0" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @* Validación en el navegador con jQuery Validation (viene en la plantilla MVC) *@
    <partial name="_ValidationScriptsPartial" />
}
