@model List<PrototipoCRUD.Models.Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Catálogo de Productos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo producto</a>
</div>

@* Mensaje de confirmación que manda el controlador con TempData *@
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no hay productos registrados.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th class="text-end">Precio (Bs.)</th>
                <th class="text-end">Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Codigo</td>
                    <td>@p.Nombre</td>
                    <td class="text-end">@p.Precio.ToString("N2")</td>
                    <td class="text-end">@p.Stock</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Editar</a>

                        @* Formulario POST para eliminar, con confirmación en JavaScript *@
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Seguro que desea eliminar @p.Nombre?');">
                            <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
