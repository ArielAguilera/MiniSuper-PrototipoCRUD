<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Minisúper El Ahorro</title>
    @* Misma tipografía que en Figma (Roboto). Si no hay internet, usa la fuente del sistema. *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Actividad 6: diseño 20/80 igual que en Figma.
       Barra lateral fija (~20%) = navegación constante.
       Área de trabajo (~80%) = contenido de cada módulo. *@
    <div class="contenedor-app">

        <aside class="barra-lateral">
            <div class="marca">
                <div class="marca-titulo">Minisúper</div>
                <div class="marca-sub">El Ahorro</div>
            </div>

            @{
                // Para marcar en el menú el módulo en el que estamos
                var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
            }
            <nav class="menu">
                <a class="menu-item @(controladorActual == "Producto" ? "activo" : "")"
                   asp-controller="Producto" asp-action="Index">Productos</a>
                <a class="menu-item @(controladorActual == "Venta" ? "activo" : "")"
                   asp-controller="Venta" asp-action="Create">Ventas</a>
                <a class="menu-item @(controladorActual == "Reporte" ? "activo" : "")"
                   asp-controller="Reporte" asp-action="Index">Reportes</a>
            </nav>

            <div class="usuario">Usuario: Administrador</div>
        </aside>

        <main class="area-trabajo" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
