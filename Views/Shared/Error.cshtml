@model ErrorViewModel
@{
    ViewData["Title"] = "Inconveniente inesperado";
}

@* Actividad 9: pantalla final de seguridad. Nunca muestra detalles técnicos ni StackTrace. *@
<h2 class="mb-3">Tuvimos un inconveniente inesperado</h2>

<div class="alerta-error mb-3">
    No pudimos completar lo que intentabas hacer. Tus datos guardados no se perdieron.
    Vuelve al catálogo e inténtalo de nuevo en unos segundos; si el problema continúa, avisa a soporte.
</div>

@if (Model.ShowRequestId)
{
    <p class="text-muted small">
        Código de referencia para soporte: <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Producto" asp-action="Index" class="btn btn-principal">Volver al catálogo</a>
