@using System.Linq
@model PrototipoCRUD.Models.Venta
@{
    ViewData["Title"] = "Registrar Nueva Venta";
    var productos = ViewBag.Productos as List<PrototipoCRUD.Models.Producto> ?? new List<PrototipoCRUD.Models.Producto>();

    // CR-01: valor del descuento que se vuelve a mostrar si hubo que corregir algo
    decimal? porcentajeIngresado = ViewBag.PorcentajeIngresado as decimal?;
    string valorPorcentaje = (porcentajeIngresado ?? Model.PorcentajeDescuento)
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Carrito que se vuelve a dibujar si el servidor devolvió el formulario con un aviso
    var carritoInicial = Model.Detalles.Select(d => new
    {
        idProducto = d.IdProducto,
        nombre = d.NombreProducto,
        precioUnitario = d.PrecioUnitario,
        cantidad = d.Cantidad
    });
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0" style="color: #1E293B;">Registro de Venta (Punto de Venta)</h2>
        <small class="text-muted">Minisúper El Ahorro — Operación Transaccional Maestro-Detalle</small>
    </div>
    <span class="badge bg-secondary fs-6">Fecha: @DateTime.Now.ToString("dd/MM/yyyy")</span>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>¡Operación exitosa!</strong> @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Atención:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Create" method="post" id="formVenta">
    @Html.AntiForgeryToken()

    <!-- 1. SECCIÓN MAESTRO (Cabecera de la Venta) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header text-white fw-semibold" style="background-color: #1E293B;">
            1. Datos Generales de la Venta (Cabecera)
        </div>
        <div class="card-body bg-white">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label asp-for="Cliente" class="form-label fw-semibold">Nombre o Razón Social del Cliente</label>
                    <input asp-for="Cliente" class="form-control" value="Cliente General" required />
                </div>
                <div class="col-md-4 mt-3 mt-md-0">
                    <label asp-for="Vendedor" class="form-label fw-semibold">Vendedor</label>
                    <input asp-for="Vendedor" class="form-control" maxlength="100"
                           placeholder="Ej. Carlos Pérez" required />
                </div>
                <div class="col-md-4 mt-3 mt-md-0">
                    <label for="porcentajeDescuento" class="form-label fw-semibold">Descuento al cliente (%)</label>
                    <div class="input-group">
                        <input type="number" id="porcentajeDescuento" name="porcentajeDescuento"
                               class="form-control text-end" value="@valorPorcentaje"
                               min="0" step="0.01" inputmode="decimal" />
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="form-text">Máximo permitido por política: 20%.</div>
                </div>
            </div>
            <div id="avisoDescuento" class="alert alert-warning py-2 mt-3 mb-0 d-none" role="alert"></div>
            <div class="text-muted small mt-3">Cajero activo: <strong>Caja Principal</strong></div>
        </div>
    </div>

    <!-- 2. SELECTOR PARA AGREGAR PRODUCTOS AL DETALLE -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light fw-semibold" style="color: #1E293B;">
            2. Agregar Productos al Carrito
        </div>
        <div class="card-body bg-white">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Seleccione Producto</label>
                    <select id="selectProducto" class="form-select">
                        <option value="">-- Elija un producto del catálogo --</option>
                        @foreach (var p in productos)
                        {
                            <option value="@p.Id"
                                    data-nombre="@p.Nombre"
                                    data-precio="@p.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-stock="@p.Stock">
                                [@p.Codigo] @p.Nombre — Bs. @p.Precio.ToString("N2") (Stock: @p.Stock)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Cantidad</label>
                    <input type="number" id="txtCantidad" class="form-control text-end" value="1" min="1" />
                </div>
                <div class="col-md-3">
                    <button type="button" id="btnAgregarItem" class="btn btn-primary w-100">
                        + Agregar al detalle
                    </button>
                </div>
            </div>
            <div id="avisoCarrito" class="text-danger small mt-2 d-none"></div>
        </div>
    </div>

    <!-- 3. SECCIÓN DETALLE (Tabla Dinámica en Memoria) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header text-white fw-semibold" style="background-color: #1E293B;">
            3. Detalle de Productos a Vender
        </div>
        <div class="card-body p-0 bg-white">
            <table class="table table-hover table-bordered mb-0 align-middle" id="tablaDetalle">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th class="text-end" style="width: 140px;">Precio Unit. (Bs.)</th>
                        <th class="text-end" style="width: 120px;">Cantidad</th>
                        <th class="text-end" style="width: 150px;">Subtotal (Bs.)</th>
                        <th class="text-center" style="width: 110px;">Acción</th>
                    </tr>
                </thead>
                <tbody id="cuerpoDetalle">
                    <tr id="filaVacia">
                        <td colspan="5" class="text-center text-muted py-4">
                            Aún no ha agregado productos a esta venta.
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <td colspan="3" class="text-end">Subtotal bruto (Bs.):</td>
                        <td class="text-end" id="lblSubtotalBruto">0.00</td>
                        <td></td>
                    </tr>
                    <tr class="table-light">
                        <td colspan="3" class="text-end">Descuento (<span id="lblPorcentaje">0</span>%) (Bs.):</td>
                        <td class="text-end text-danger" id="lblMontoDescuento">- 0.00</td>
                        <td></td>
                    </tr>
                    <tr class="table-light">
                        <td colspan="3" class="text-end fw-bold fs-5">TOTAL A COBRAR (Bs.):</td>
                        <td class="text-end fw-bold fs-5 text-success" id="lblTotalGeneral">0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Contenedor vacío que JavaScript llena dinámicamente al agregar productos -->
    <div id="inputsOcultos"></div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Create" class="btn btn-outline-secondary">Limpiar Todo</a>
        <button type="submit" class="btn btn-success btn-lg px-4">
            Confirmar y Registrar Venta
        </button>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Si el servidor devolvió el formulario con un aviso, recuperamos el carrito
            let carrito = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(carritoInicial));
            const DESCUENTO_MAXIMO = 20;
            const sepDecimal = "@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator";

            const selectProducto = document.getElementById("selectProducto");
            const txtCantidad = document.getElementById("txtCantidad");
            const btnAgregar = document.getElementById("btnAgregarItem");
            const cuerpoDetalle = document.getElementById("cuerpoDetalle");
            const inputsOcultos = document.getElementById("inputsOcultos");
            const lblTotalGeneral = document.getElementById("lblTotalGeneral");
            const avisoCarrito = document.getElementById("avisoCarrito");
            const formVenta = document.getElementById("formVenta");
            const txtDescuento = document.getElementById("porcentajeDescuento");
            const avisoDescuento = document.getElementById("avisoDescuento");
            const lblSubtotalBruto = document.getElementById("lblSubtotalBruto");
            const lblPorcentaje = document.getElementById("lblPorcentaje");
            const lblMontoDescuento = document.getElementById("lblMontoDescuento");

            // Devuelve { valido, porcentaje, mensaje } según la regla 0% – 20%
            function leerDescuento() {
                const texto = txtDescuento.value.trim();
                if (texto === "") return { valido: true, porcentaje: 0, mensaje: "" };
                const p = parseFloat(texto);
                if (isNaN(p)) {
                    return { valido: false, porcentaje: 0,
                        mensaje: "Escribe el descuento como un número entre 0 y " + DESCUENTO_MAXIMO + " (ej. 10 o 12.5)." };
                }
                if (p < 0) {
                    return { valido: false, porcentaje: 0,
                        mensaje: "El descuento no puede ser negativo. Escribe un valor entre 0 y " + DESCUENTO_MAXIMO + "." };
                }
                if (p > DESCUENTO_MAXIMO) {
                    return { valido: false, porcentaje: 0,
                        mensaje: "El descuento máximo que puedes otorgar es " + DESCUENTO_MAXIMO + "%. " +
                                 "Ingresaste " + p + "%: ajústalo a " + DESCUENTO_MAXIMO + "% o menos para continuar." };
                }
                return { valido: true, porcentaje: p, mensaje: "" };
            }

            function redondear2(n) {
                return Math.round((n + Number.EPSILON) * 100) / 100;
            }

            function mostrarAviso(msg) {
                avisoCarrito.textContent = msg;
                avisoCarrito.classList.remove("d-none");
            }

            function ocultarAviso() {
                avisoCarrito.classList.add("d-none");
            }

            btnAgregar.addEventListener("click", function () {
                ocultarAviso();
                const opcion = selectProducto.options[selectProducto.selectedIndex];

                if (!opcion || !opcion.value) {
                    mostrarAviso("Seleccione un producto de la lista.");
                    return;
                }

                const idProducto = parseInt(opcion.value);
                const nombre = opcion.getAttribute("data-nombre");
                const precio = parseFloat(opcion.getAttribute("data-precio"));
                const stock = parseInt(opcion.getAttribute("data-stock"));
                const cantidad = parseInt(txtCantidad.value);

                if (isNaN(cantidad) || cantidad <= 0) {
                    mostrarAviso("La cantidad debe ser mayor a 0.");
                    return;
                }

                const existente = carrito.find(x => x.idProducto === idProducto);
                const cantidadTotal = (existente ? existente.cantidad : 0) + cantidad;

                if (cantidadTotal > stock) {
                    mostrarAviso(`Stock insuficiente. Solo quedan ${stock} unidades disponibles de ${nombre}.`);
                    return;
                }

                if (existente) {
                    existente.cantidad = cantidadTotal;
                } else {
                    carrito.push({
                        idProducto: idProducto,
                        nombre: nombre,
                        precioUnitario: precio,
                        cantidad: cantidad
                    });
                }

                txtCantidad.value = "1";
                selectProducto.selectedIndex = 0;
                renderizarTabla();
            });

            window.quitarItem = function (indice) {
                carrito.splice(indice, 1);
                renderizarTabla();
            };

            function renderizarTabla() {
                cuerpoDetalle.innerHTML = "";
                inputsOcultos.innerHTML = "";

                if (carrito.length === 0) {
                    cuerpoDetalle.innerHTML = `
                        <tr id="filaVacia">
                            <td colspan="5" class="text-center text-muted py-4">
                                Aún no ha agregado productos a esta venta.
                            </td>
                        </tr>`;
                    actualizarTotales(0);
                    return;
                }

                let total = 0;

                carrito.forEach((item, index) => {
                    const subtotal = item.cantidad * item.precioUnitario;
                    total += subtotal;

                    const tr = document.createElement("tr");

                    const c1 = tr.insertCell();
                    c1.textContent = item.nombre;

                    const c2 = tr.insertCell();
                    c2.className = "text-end";
                    c2.textContent = item.precioUnitario.toFixed(2);

                    const c3 = tr.insertCell();
                    c3.className = "text-end";
                    c3.textContent = item.cantidad;

                    const c4 = tr.insertCell();
                    c4.className = "text-end fw-semibold";
                    c4.textContent = subtotal.toFixed(2);

                    const c5 = tr.insertCell();
                    c5.className = "text-center";
                    const btnQuitar = document.createElement("button");
                    btnQuitar.type = "button";
                    btnQuitar.className = "btn btn-sm btn-outline-danger";
                    btnQuitar.textContent = "Quitar";
                    btnQuitar.onclick = () => quitarItem(index);
                    c5.appendChild(btnQuitar);

                    cuerpoDetalle.appendChild(tr);

                    const precioFormateado = item.precioUnitario.toFixed(2).replace(".", sepDecimal);
                    const campos = {
                        IdProducto: item.idProducto,
                        NombreProducto: item.nombre,
                        Cantidad: item.cantidad,
                        PrecioUnitario: precioFormateado
                    };

                    for (const [clave, valor] of Object.entries(campos)) {
                        const hidden = document.createElement("input");
                        hidden.type = "hidden";
                        hidden.name = `Detalles[${index}].${clave}`;
                        hidden.value = valor;
                        inputsOcultos.appendChild(hidden);
                    }
                });

                actualizarTotales(total);
            }

            // Cálculo en tiempo real: subtotal bruto, descuento y total final
            function actualizarTotales(subtotalBruto) {
                const d = leerDescuento();
                if (d.valido) {
                    avisoDescuento.classList.add("d-none");
                    txtDescuento.classList.remove("is-invalid");
                } else {
                    avisoDescuento.textContent = d.mensaje;
                    avisoDescuento.classList.remove("d-none");
                    txtDescuento.classList.add("is-invalid");
                }
                // Si el valor no es válido no se aplica ningún descuento en la vista previa
                const monto = redondear2(subtotalBruto * (d.porcentaje / 100));
                lblSubtotalBruto.textContent = subtotalBruto.toFixed(2);
                lblPorcentaje.textContent = d.porcentaje;
                lblMontoDescuento.textContent = "- " + monto.toFixed(2);
                lblTotalGeneral.textContent = (subtotalBruto - monto).toFixed(2);
            }

            function subtotalActual() {
                return carrito.reduce((acc, x) => acc + x.cantidad * x.precioUnitario, 0);
            }

            txtDescuento.addEventListener("input", function () {
                actualizarTotales(subtotalActual());
            });

            // Antes de enviar: si el descuento no es válido, avisamos y no enviamos (el servidor y la BD también lo validan)
            formVenta.addEventListener("submit", function (e) {
                const d = leerDescuento();
                if (!d.valido) {
                    e.preventDefault();
                    actualizarTotales(subtotalActual());
                    txtDescuento.focus();
                }
            });

            // Dibuja el carrito inicial (vacío o recuperado tras un aviso del servidor)
            renderizarTabla();
        });
    </script>
}
